# FetchNews environment file.
#
# All APP_ prefixed variables are consumed by fetchnews/settings.py::Settings.
# Entries without the APP_ prefix are either consumed by the frontend / docker
# compose, or are reserved placeholders that no code currently reads.

# --- Core app ---
APP_NAME=FetchNews
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Persistence & transport ---
APP_DATABASE_URL=postgresql+psycopg://fetchnews:fetchnews@localhost:5432/fetchnews
APP_DATABASE_BOOTSTRAP_MODE=skip
APP_REDIS_URL=redis://localhost:6379/0
APP_CORS_ORIGINS=["http://localhost:5173"]

# --- Scheduling, rate limit, retry, alerting ---
APP_INGEST_INTERVAL_SECONDS=1800
APP_PUBLISH_INTERVAL_SECONDS=60
# Seconds a platform is skipped for new dispatch after it produced a
# `rate_limit` failure classification. This is a post-failure back-off
# window, not a proactive per-second throttle.
APP_PUBLISH_RATE_LIMIT_WINDOW_SECONDS=300
APP_SOURCE_RETRY_ATTEMPTS=2
APP_SOURCE_FAILURE_ALERT_THRESHOLD=3
# Mock publisher completion delay in seconds. Keep at 0 outside of local
# integration tests.
APP_MOCK_PUBLISH_COMPLETION_SECONDS=0

# --- Publishing ---
APP_PUBLISH_REAL_PLATFORM=
APP_PUBLISH_CALLBACK_SECRET=fetchnews-dev-callback-secret

# --- Auth ---
APP_AUTH_ENABLED=true
APP_AUTH_SECRET_KEY=change-this-before-exposing-the-console
APP_ACCESS_TOKEN_EXPIRE_MINUTES=720
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=admin-secret
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=FetchNews Admin

# --- External platform credentials ---
APP_GITHUB_TOKEN=
APP_TELEGRAM_BOT_TOKEN=
APP_TELEGRAM_CHAT_ID=
APP_X_BEARER_TOKEN=
APP_WECHAT_APP_ID=

# --- Frontend (consumed by web/ via Vite, not by Settings) ---
VITE_API_BASE=http://localhost:8000

# --- Reserved: not consumed by any code path yet ---
# Object storage is reserved for a future phase (media asset handling).
OBJECT_STORAGE_BUCKET=fetchnews-assets
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# OpenAI API key is reserved for the Phase 08 real LLM provider work.
OPENAI_API_KEY=
